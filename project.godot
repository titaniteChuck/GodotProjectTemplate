; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addon_importer]

show_on_startup=false

[application]

config/name="Craft it out"
run/main_scene="res://src/this_game/_game_scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://addons/scene_manager/autoload/scene_manager.tscn"
SaveSystem="*res://addons/save_system/autoload/save_system.tscn"
ItemSystem="*res://addons/item_system/autoload/item_system.tscn"
GameLevelService="*res://src/this_game/model/game_level/services/game_level_service.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/always_on_top=true
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/drag_and_drop/plugin.cfg", "res://addons/item_system/plugin.cfg", "res://addons/resource_path/plugin.cfg", "res://addons/save_system/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/locale_filter_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[run_configs]

data/configs=["{\"custom_scene\":\"\",\"environment_variables\":{\"TEST\":\"value\"},\"name\":\"Test\",\"play_mode\":0}"]
data/current=0
